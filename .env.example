# Optional host-side URL; Compose overrides it with the internal db hostname.
DATABASE_URL=postgresql+psycopg://support_user:change-me@localhost:5432/support_platform
LOG_LEVEL=INFO

# Docker Compose uses these values to initialize PostgreSQL and build DATABASE_URL.
POSTGRES_USER=support_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=support_platform
API_WORKERS=2

# Kafka stays on the Compose network; application containers use this hostname.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_INCIDENT_CREATED_TOPIC=incident.created
KAFKA_TOPIC_PARTITIONS=3
KAFKA_CONSUMER_GROUP=incident-processing-v1
KAFKA_PRODUCER_CLIENT_ID=support-api
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=5000
KAFKA_PRODUCER_RETRIES=5
KAFKA_OUTBOX_POLL_INTERVAL_SECONDS=5
KAFKA_OUTBOX_BATCH_SIZE=20
KAFKA_WORKER_CLIENT_ID=incident-worker
KAFKA_WORKER_POLL_TIMEOUT_SECONDS=1
KAFKA_WORKER_MAX_POLL_INTERVAL_MS=900000
KAFKA_WORKER_RETRY_BACKOFF_SECONDS=2

# Self-hosted Phase 4 AI providers. Compose keeps Ollama internal by default.
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:v1.5
OLLAMA_REQUEST_TIMEOUT_SECONDS=180
OLLAMA_KEEP_ALIVE=5m

# nomic-embed-text:v1.5 emits 768 dimensions; changing this requires a migration.
EMBEDDING_DIMENSIONS=768
KNOWLEDGE_BASE_PATH=knowledge_base
KNOWLEDGE_CHUNK_SIZE=900
KNOWLEDGE_RETRIEVAL_TOP_K=4
AI_MAX_ATTEMPTS=5
AI_PROCESSING_STALE_SECONDS=900

# Phase 5 controlled-agent budgets and versioned image-bundled prompts.
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_REPEATED_TOOL_CALLS=1
AGENT_MAX_RETRIEVAL_CHUNKS=4
AGENT_MAX_DURATION_SECONDS=600
AGENT_TOOL_TIMEOUT_SECONDS=180
AGENT_MODEL_RETRIES=3
AGENT_REPAIR_ATTEMPTS=2
AGENT_PLANNER_PROMPT_VERSION=v2
AGENT_RESOLVER_PROMPT_VERSION=v1

# Phase 6 telemetry. API/worker override service names inside Compose.
OTEL_SERVICE_NAME=ai-support-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development,service.namespace=ai-support-platform

# Development-only Grafana login; choose a local value and never commit .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_PORT=3000
