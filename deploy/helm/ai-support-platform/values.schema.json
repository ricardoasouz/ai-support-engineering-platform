{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["global", "image", "api", "worker", "secrets", "postgres", "kafka", "ollama", "observability"],
  "properties": {
    "global": {
      "type": "object",
      "required": ["appEnvironment"],
      "properties": {
        "appEnvironment": {
          "type": "string",
          "enum": ["development", "test", "integration", "production-like"]
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["tag", "pullPolicy"],
      "properties": {
        "tag": {"type": "string", "minLength": 1, "not": {"const": "latest"}},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "api": {
      "type": "object",
      "required": ["replicaCount", "image", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 100},
        "workersPerPod": {"type": "integer", "minimum": 1, "maximum": 16}
      }
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "image", "resources"],
      "properties": {
        "replicaCount": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "secrets": {
      "type": "object",
      "required": ["create", "existingSecret", "keys", "values"],
      "properties": {
        "create": {"type": "boolean"},
        "existingSecret": {"type": "string"},
        "values": {
          "type": "object",
          "properties": {
            "databaseUrl": {"type": "string"},
            "postgresPassword": {"type": "string"},
            "grafanaAdminPassword": {"type": "string"}
          }
        }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["enabled", "image", "persistence", "resources"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "kafka": {
      "type": "object",
      "required": ["enabled", "image", "persistence", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "externalBootstrapServers": {"type": "string"}
      }
    },
    "ollama": {
      "type": "object",
      "required": ["enabled", "image", "models", "persistence", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "externalBaseUrl": {"type": "string"}
      }
    },
    "observability": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "externalEgressCidrs": {
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {"enabled": {"type": "boolean"}}
    }
  }
}
